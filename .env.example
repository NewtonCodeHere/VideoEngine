# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=info

# ── Footage Provider ──────────────────────────────────────────────────────────
# Set FOOTAGE_PROVIDER=pexels and provide your Pexels API key for real footage.
# Free key at: https://www.pexels.com/api/
FOOTAGE_PROVIDER=mock
PEXELS_API_KEY=your_pexels_api_key_here

FOOTAGE_MAX_CLIPS_PER_JOB=20
FOOTAGE_MIN_RELEVANCE=0.25

# ── TTS Provider ──────────────────────────────────────────────────────────────
# Options: gtts | edge | espeak | mock
# gtts  – free, internet required, pip install gtts
# edge  – free, internet required, pip install edge-tts
# espeak – offline, install espeak-ng system package
# mock  – silent audio, for testing only
TTS_PROVIDER=gtts
TTS_LANGUAGE=en
TTS_VOICE=default

# For edge-tts, specify the neural voice name:
EDGE_TTS_VOICE=en-US-AriaNeural

# ── Transcription (for audio-input mode) ─────────────────────────────────────
# Options: whisper | mock
# whisper requires: pip install openai-whisper (large download)
TRANSCRIPTION_PROVIDER=mock

# ── FFmpeg Paths ──────────────────────────────────────────────────────────────
# Leave as 'ffmpeg'/'ffprobe' if they are on your PATH,
# or provide absolute paths e.g. C:/ffmpeg/bin/ffmpeg.exe
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ── Video Output Settings ─────────────────────────────────────────────────────
VIDEO_FPS=30
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_CRF=23
VIDEO_PRESET=fast
AUDIO_BITRATE=128k
VIDEO_BITRATE=2000k

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_PDF_SIZE_MB=50
MAX_PDF_PAGES=200
MAX_AUDIO_SIZE_MB=100
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_SECONDS=600
